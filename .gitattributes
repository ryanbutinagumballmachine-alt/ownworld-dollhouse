# ==============================================================================
# Default Behavior: Normalize text files to LF
# ==============================================================================
* text=auto eol=lf

# ==============================================================================
# Godot Project & Text Resources (Always LF)
# ==============================================================================
*.godot         text eol=lf
*.cfg           text eol=lf
*.gd            text eol=lf
*.tscn          text eol=lf
*.tres          text eol=lf
*.import        text eol=lf
*.gdshader      text eol=lf
*.shader        text eol=lf
*.json          text eol=lf
*.xml           text eol=lf
*.svg           text eol=lf

# ==============================================================================
# C# / .NET Files (If applicable)
# ==============================================================================
*.cs            text eol=lf diff=csharp
*.csproj        text eol=lf
*.sln           text eol=crlf

# ==============================================================================
# Binary Image & Art Assets
# ==============================================================================
*.png           binary
*.jpg           binary
*.jpeg          binary
*.webp          binary
*.ico           binary
*.icns          binary
*.psd           binary
*.ase           binary
*.aseprite      binary

# ==============================================================================
# Binary Audio & Sound Assets
# ==============================================================================
*.wav           binary
*.ogg           binary
*.mp3           binary
*.flac          binary

# ==============================================================================
# Binary Typography / Fonts
# ==============================================================================
*.ttf           binary
*.otf           binary
*.woff          binary
*.woff2         binary

# ==============================================================================
# 3D Assets (If used)
# ==============================================================================
*.glb           binary
*.fbx           binary
*.blend         binary
*.gltf          text eol=lf

# ==============================================================================
# Archives, Build Binaries & Custom Story Packs
# ==============================================================================
*.ownpack       binary
*.zip           binary
*.tar.gz        binary
*.pck           binary
*.apk           binary
*.aab           binary
*.exe           binary
*.dll           binary
*.so            binary
*.dylib         binary
*.keystore      binary
*.jks           binary

# ==============================================================================
# GitHub / GitLab Linguist Overrides (Keep repo language stats accurate)
# ==============================================================================
*.tscn          linguist-detectable=false
*.tres          linguist-detectable=false
*.import        linguist-generated=true